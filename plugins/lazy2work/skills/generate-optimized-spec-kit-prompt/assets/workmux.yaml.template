# .workmux.yaml — SpecKit 2-Phase 병렬 실행용 설정
#
# 이 파일은 템플릿이다. {{ }} 자리를 프로젝트 값으로 채운 뒤 프로젝트 루트에 `.workmux.yaml` 로 둔다.
# 이미 .workmux.yaml 이 있다면 덮어쓰지 말고 layouts.speckit / pre_merge 만 병합해 넣는다.

main_branch: {{ MAIN_BRANCH }}
base_branch: {{ MAIN_BRANCH }}   # ⚠️ 필수 — 생략하면 기본값이 "현재 체크아웃된 브랜치"라서 엉뚱한 base 에서 분기한다

window_prefix: sk-

# session: 드라이버를 tmux 밖에서 실행할 수 있다 (window 모드는 tmux 세션 안에서만 동작).
mode: session

merge_strategy: rebase   # 선형 히스토리 — 웨이브 병합 순서가 그대로 보인다
merge_keep: true         # 병합 후에도 worktree 보존 → 자동 실행이 잘못돼도 증거가 남는다.
                         #   검수 후 `workmux rm --all` 로 정리한다.

layouts:
  # ★ 반드시 단일 pane.
  #   -W/--wait 와 --max-concurrent 는 "창이 닫혀야" 진행하고, 창은 "모든 pane 이 종료돼야" 닫힌다.
  #   기본 레이아웃(에이전트 + 셸)은 셸이 죽지 않아 영원히 멈춘다.
  #   또한 대화형 `claude` 는 스스로 종료하지 않으므로 agent pane 이 아니라 script pane 이어야 한다.
  speckit:
    panes:
      - command: 'bash utilities/wm_stage_runner.sh {{ PROMPTS_PATH }}'
        focus: true

files:
  copy:
    # worktree 는 gitignored 파일이 없는 깨끗한 체크아웃이다. 실행에 필요한 로컬 설정만 복사한다.
    # Phase 1(spec) 은 드라이버가 --no-file-ops 로 건너뛰므로 Phase 2 에만 적용된다.
{{ FILES_COPY }}
  # ⚠️ 가상환경(.venv, node_modules 등)은 symlink/copy 금지 — 절대경로가 박혀 있어 worktree 간에 서로를 덮어쓴다.
  #    post_create 로 worktree 마다 새로 만든다.

post_create:
  # worktree 생성 직후, tmux 창이 열리기 전에 블로킹 실행된다 → 빠르게 유지할 것.
  # Phase 1(spec) 은 드라이버가 --no-hooks 로 건너뛴다 (코드를 건드리지 않으므로 의존성이 불필요).
{{ POST_CREATE }}

pre_merge:
  # ★ 병합 게이트 — 실패하면 병합이 중단되고 worktree 가 보존된다.
  #   spec  단계: spec.md 존재 + [NEEDS CLARIFICATION] 0건
  #   build 단계: plan.md·tasks.md 존재 + 미완료 태스크 0건 + 검증 명령 통과
  - 'bash utilities/wm_pre_merge_gate.sh'
