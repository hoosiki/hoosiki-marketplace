# .workmux.yaml — SpecKit Phase 2 (수직 웨이브) 병렬 실행용 설정
#
# 이 파일은 템플릿이다. {{ }} 자리를 프로젝트 값으로 채운 뒤 프로젝트 루트에 `.workmux.yaml` 로 둔다.
# 이미 .workmux.yaml 이 있다면 덮어쓰지 말고 layouts.speckit / pre_merge 만 병합해 넣는다.
#
# ⚠️ Phase 1(spec) 은 workmux 를 쓰지 않는다 — 드라이버가 메인 워킹트리에서 백그라운드 병렬로 돌린다.
#    이 설정은 Phase 2(build) 전용이고, worktree 하나가 웨이브 하나(= 의존성 체인)를 담당한다.

main_branch: {{ MAIN_BRANCH }}
base_branch: {{ MAIN_BRANCH }}   # ⚠️ 필수 — 생략하면 기본값이 "현재 체크아웃된 브랜치"라서 엉뚱한 base 에서 분기한다

window_prefix: sk-

# session: 드라이버를 tmux 밖에서 실행할 수 있다 (window 모드는 tmux 세션 안에서만 동작).
mode: session

merge_strategy: merge    # ⚠️ rebase 아님. 웨이브 하나가 feature 여러 개의 커밋을 통째로 들고 오므로
                         #   rebase 는 같은 hotspot 충돌을 커밋 수만큼 반복해서 물어본다.
                         #   merge 커밋 하나면 한 번에 끝난다. (짧은 단일 feature 웨이브만 `--rebase` 권장)
merge_keep: true         # 병합 후에도 worktree 보존 → 자동 실행이 잘못돼도 증거가 남는다.
                         #   검수 후 `workmux rm --all` 로 정리한다.

layouts:
  # ★ 반드시 단일 pane, 그리고 반드시 끝에 `; exit`.
  #   -W/--wait 와 --max-concurrent 는 "창이 닫혀야" 진행하고, 창은 "모든 pane 이 종료돼야" 닫힌다.
  #   1) 기본 레이아웃(에이전트 + 셸)은 셸이 죽지 않아 영원히 멈춘다 → pane 은 1개.
  #   2) 대화형 `claude` 는 스스로 종료하지 않는다 → agent pane 이 아니라 script pane.
  #   3) ⚠️ pane command 는 "셸에 입력되는 명령"이다. 스크립트가 끝나도 셸은 프롬프트로 돌아가
  #      살아남는다 → `; exit` 이 없으면 창이 영영 닫히지 않고 드라이버가 -W 에서 멈춘다.
  speckit:
    panes:
      - command: 'bash utilities/wm_stage_runner.sh {{ PROMPTS_PATH }}; exit'
        focus: true

files:
  copy:
    # worktree 는 gitignored 파일이 없는 깨끗한 체크아웃이다. 실행에 필요한 로컬 설정만 복사한다.
{{ FILES_COPY }}
  # ⚠️ 가상환경(.venv, node_modules 등)은 symlink/copy 금지 — 절대경로가 박혀 있어 worktree 간에 서로를 덮어쓴다.
  #    post_create 로 worktree 마다 새로 만든다.

post_create:
  # worktree 생성 직후, tmux 창이 열리기 전에 블로킹 실행된다 → 빠르게 유지할 것.
{{ POST_CREATE }}

pre_merge:
  # ★ 병합 게이트 — 실패하면 병합이 중단되고 worktree 가 보존된다.
  #   브랜치 'build/<wave>' 에서 웨이브를 뽑아 그 웨이브의 feature 를 전부 검사한다:
  #   plan.md·tasks.md 존재 + 미완료 태스크 0건 + 프로젝트 검증 명령 1회 통과.
  - 'bash utilities/wm_pre_merge_gate.sh'
